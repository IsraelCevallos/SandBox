library(dplyr)
data("iris")
str(iris)
View(iris)
head(iris)
new_iris <- iris %>%
filter(Sepal.Length > 5 & Petal.Length > 3) %>%
mutate(Sepal.Area = Sepal.Length * Sepal.Width,
Petal.Area = Petal.Length * Petal.Width)
# View new data
head(new_iris)
# Filter and mutate data
new_iris <- iris %>%
filter(Sepal.Length > 5 & Petal.Length > 3) %>%
mutate(Sepal.Area = Sepal.Length * Sepal.Width,
Petal.Area = Petal.Length * Petal.Width) %>%
group_by(Species)
